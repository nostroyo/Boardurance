# Rust Build Artifacts
/target/
**/*.rs.bk
# Cargo.lock is committed: this is a binary/app, not a library — reproducible
# builds in CI/Docker require the lockfile (see Dockerfile `cargo ... --locked`).

# Environment Variables and Secrets
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# Configuration files with secrets
configuration/local.yaml
configuration/staging.yaml
# configuration/production.yaml is committed: it holds NO secrets (empty db
# username/password placeholders) — the real OVH connection comes from the
# APP_DATABASE__URI env var. The config loader requires the {env}.yaml file to
# exist (it supplies application.port), so the prod image must contain it.
*.key
*.pem
secrets/
.secrets/

# Database
*.db
*.sqlite

# Docker
.docker/
docker-compose.override.yml

# Logs and Runtime
*.log
logs/

# Editor and IDE
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db